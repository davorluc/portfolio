---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Davor Luc — Data, web & infrastructure"
  description="Davor Luc's portfolio: connecting data, web and infrastructure. Selected case studies and contact details are being prepared."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="crt-header crt-inner">
    <a class="wordmark" href="#top" aria-label="Davor Luc, back to top">Davor Luc</a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#approach">Approach</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <section class="crt-screen" id="top" aria-labelledby="hero-title">
      <div class="crt-backdrop" aria-hidden="true">
        <img src="/media/dunes-poster.webp" width="1280" height="720" alt="" fetchpriority="high" />
        <video muted playsinline loop preload="none" poster="/media/dunes-poster.webp" tabindex="-1"></video>
      </div>
      <div class="crt-scrim" aria-hidden="true"></div>
      <div class="crt-scan" aria-hidden="true"></div>
      <div class="crt-glass" aria-hidden="true"></div>
      <div class="crt-edge" aria-hidden="true"></div>
      <div class="crt-hero crt-inner">
        <div class="crt-copy">
          <p class="crt-eyebrow crt-eyebrow-wide">Data engineering / Web development / DevOps</p>
          <p class="crt-eyebrow crt-eyebrow-short">Data / Web / DevOps</p>
          <h1 id="hero-title">I build across layers.</h1>
          <a class="crt-cta" href="#work">Explore portfolio <span aria-hidden="true">↓</span></a>
          <p class="crt-pending">Case studies and contact details are being prepared.</p>
        </div>
      </div>
      <button class="crt-play" type="button" hidden>Pause background</button>
      <p class="crt-status" role="status" aria-live="polite"></p>
    </section>

    <section class="section container work" id="work" aria-labelledby="work-title">
      <div class="section-intro">
        <p class="eyebrow">02 / Selected work</p>
        <h2 id="work-title">Decisions under real constraints.</h2>
        <p>Good case studies show the problem, the decision and what changed. Those details will appear here when they can be shared accurately.</p>
      </div>
      <div class="work-pending" role="note" aria-label="Case study publication status">
        <div>
          <p class="eyebrow">Case studies / in preparation</p>
          <h3>Work worth explaining, not inventing.</h3>
          <p>Project stories are being prepared. No example is presented as a completed case until its role, constraints and outcome are confirmed.</p>
        </div>
        <div class="work-structure" aria-label="What future case studies will cover">
          <span>01 / The problem</span>
          <span>02 / The decision</span>
          <span>03 / The outcome</span>
        </div>
      </div>
    </section>

    <section class="section container domains" id="domains" aria-labelledby="domains-title">
      <div class="section-intro">
        <p class="eyebrow">03 / Across the system</p>
        <h2 id="domains-title">Different layers. One connected problem.</h2>
        <p>Data engineering, web development and DevOps / infrastructure are the three parts of the work this portfolio is here to connect.</p>
      </div>
      <ol class="domain-list">
        <li><span class="domain-number">01</span><h3>Data</h3><p>How information moves and becomes useful.</p></li>
        <li><span class="domain-number">02</span><h3>Web</h3><p>How people meet the system through an interface.</p></li>
        <li><span class="domain-number">03</span><h3>Infrastructure</h3><p>How the system gets delivered and kept running.</p></li>
      </ol>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="container approach-inner">
        <div>
          <p class="eyebrow">04 / Approach</p>
          <h2 id="approach-title">Understand the system.<br /><em>Improve the path through it.</em></h2>
          <div class="about-note" id="about">
            <h3>About this portfolio</h3>
            <p>I studied computer science and have worked across data engineering, web development and DevOps. The interesting problems often sit between those layers.</p>
          </div>
        </div>
        <div class="principles" aria-label="Working principles">
          <p><span>01</span> Find the failure boundary</p>
          <p><span>02</span> Make the path legible</p>
          <p><span>03</span> Leave it easier to operate</p>
        </div>
      </div>
    </section>

    <section class="contact section container" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">05 / Contact</p>
      <div class="contact-inner">
        <h2 id="contact-title">Let's make the next system clearer.</h2>
        <p>Contact details are being confirmed before a direct link is published. There is no working email or profile destination on this page yet.</p>
      </div>
    </section>
  </main>
  <footer class="site-footer container">
    <span>Davor Luc / Portfolio</span>
    <a href="#top">Back to top ↑</a>
  </footer>
  <script>
    const screen = document.querySelector<HTMLElement>('.crt-screen');
    const backdrop = screen?.querySelector<HTMLElement>('.crt-backdrop');
    const video = screen?.querySelector<HTMLVideoElement>('video');
    const button = screen?.querySelector<HTMLButtonElement>('.crt-play');
    const status = screen?.querySelector<HTMLElement>('.crt-status');
    if (screen && backdrop && video && button && status) {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let inView = false;
      let manualPause = false;
      let failed = false;
      function release() {
        video!.pause();
        video!.removeAttribute('src');
        video!.load();
        backdrop!.classList.remove('has-frame');
      }
      async function sync() {
        const canPlay = !reduced.matches && !failed;
        screen!.classList.toggle('can-play', canPlay);
        button!.hidden = !canPlay;
        if (reduced.matches) {
          release();
          status!.textContent = 'Reduced motion: static poster only.';
          return;
        }
        if (failed) {
          status!.textContent = 'Video unavailable; poster remains visible.';
          return;
        }
        if (inView && !video!.getAttribute('src')) {
          video!.src = '/media/dunes-silent.mp4';
          video!.load();
        }
        if (inView && !document.hidden && !manualPause) {
          try { await video!.play(); }
          catch { if (!failed && !reduced.matches) status!.textContent = 'Autoplay unavailable; choose Play background to retry.'; }
        } else video!.pause();
        button!.textContent = video!.paused ? 'Play background' : 'Pause background';
      }
      video.addEventListener('playing', () => {
        backdrop.classList.add('has-frame');
        button.textContent = 'Pause background';
        status.textContent = '';
      });
      video.addEventListener('error', () => {
        failed = true;
        backdrop.classList.remove('has-frame');
        void sync();
      });
      button.addEventListener('click', async () => {
        if (video.paused) {
          manualPause = false;
          button.textContent = 'Pause background';
          if (!video.getAttribute('src')) { video.src = '/media/dunes-silent.mp4'; video.load(); }
          try { await video.play(); status.textContent = ''; }
          catch { if (!failed && !reduced.matches) { button.textContent = 'Play background'; status.textContent = 'Video could not play; poster remains visible.'; } }
        } else {
          manualPause = true;
          video.pause();
          button.textContent = 'Play background';
        }
      });
      reduced.addEventListener('change', () => { void sync(); });
      document.addEventListener('visibilitychange', () => { void sync(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; void sync(); }, { threshold: .05 }).observe(screen);
      } else { inView = true; void sync(); }
    }
  </script>
</Layout>
