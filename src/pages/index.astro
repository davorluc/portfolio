---
import Layout from '../layouts/Layout.astro';
import { TIP_RECIPIENT } from '../scripts/base-tip';

const projects = [
  {
    name: 'monad-torrent', titleId: 'project-title', detailsId: 'project-details',
    stack: 'Haskell / Brick', description: 'A simple torrent client written in Haskell using Brick.',
    mediaUrl: '/media/library-silent.mp4', posterUrl: '/media/library-poster.webp',
    mediaNote: 'Temporary library concept visual, not project imagery.',
    caseUrl: '/work/monad-torrent/',
  },
  {
    name: 'devchain', titleId: 'project-title-devchain', detailsId: 'project-details-devchain',
    stack: 'Rust / SHA-256', description: 'Early Rust blockchain study of proof-of-work blocks and transaction models.',
    mediaUrl: '/media/settlement-silent.mp4', posterUrl: '/media/settlement-poster.webp',
    mediaNote: 'Temporary settlement concept visual, not blockchain or project footage.',
    caseUrl: '/work/devchain/',
  },
  {
    name: 'Hydra', titleId: 'project-title-hydra', detailsId: 'project-details-hydra',
    stack: 'Aave / concept', description: 'A concept for an Aave liquidation bot with planned Rust monitoring and Solidity execution.',
    mediaUrl: '/media/hydra-storm-silent.mp4', posterUrl: '/media/hydra-storm-poster.webp',
    mediaNote: 'Temporary storm concept visual, not a built bot or project demo.',
    caseUrl: null,
  },
] as const;

const contactEmail = 'd.lucic4@hotmail.com';
const linkedInUrl = 'https://www.linkedin.com/in/davor-lucic-467236267/';
---

<Layout
  title=" Davor Lucic — Data, web & infrastructure"
  description="Davor Lucic's portfolio: connecting data, web and infrastructure. Read the monad-torrent and devchain case studies, explore the Hydra concept, and get in touch by email or LinkedIn."
>
  <script is:inline>
    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('crt-turn-on', 'crt-secondary-ready');
      document.documentElement.dataset.powerFallback = String(window.setTimeout(() => {
        document.documentElement.classList.remove('crt-secondary-ready');
      }, 5000));
    }
  </script>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="crt-header crt-inner" id="top">
    <a class="wordmark" href="#top" aria-label=" Davor Lucic, back to top">Davor Lucic</a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#approach">Approach</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <section class="crt-screen" aria-labelledby="hero-title">
      <div class="crt-backdrop" aria-hidden="true">
        <img src="/media/dunes-poster.webp" width="1280" height="720" alt="" fetchpriority="high" />
        <video muted playsinline loop preload="none" poster="/media/dunes-poster.webp" tabindex="-1"></video>
      </div>
      <div class="crt-scrim" aria-hidden="true"></div>
      <div class="crt-scan" aria-hidden="true"></div>
      <div class="crt-glass" aria-hidden="true"></div>
      <div class="crt-edge" aria-hidden="true"></div>
      <div class="crt-hero crt-inner">
        <div class="crt-copy">
          <p class="crt-eyebrow crt-eyebrow-wide">Data engineering / Web development / DevOps</p>
          <p class="crt-eyebrow crt-eyebrow-short">Data / Web / DevOps</p>
          <h1 id="hero-title">I build across layers.</h1>
          <a class="crt-cta" href="#work">Explore portfolio <span aria-hidden="true">↓</span></a>
          <p class="crt-pending">The Hydra concept case study is in preparation.</p>
        </div>
      </div>
      <p class="crt-status" role="status" aria-live="polite"></p>
      <div class="crt-shutter" aria-hidden="true"><span class="crt-shutter-line"></span></div>
    </section>

    <section class="section container work" id="work" aria-labelledby="work-title">
      <div class="work-intro">
        <div>
          <p class="eyebrow">02 / Selected work</p>
          <h2 id="work-title">Stories worth<br /><em>telling well.</em></h2>
        </div>
        <p>Real problems. Clear decisions. Outcomes that can be shared honestly.</p>
      </div>
      <div class="work-pending" role="note" aria-label="Case study publication status">
        <p class="eyebrow">Case studies / Two available</p>
        <p>Read the monad-torrent and devchain case studies. The Hydra concept is in preparation.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-screen" data-project-name={project.name} data-video-src={project.mediaUrl} aria-labelledby={project.titleId} tabindex="0">
            <div class="project-media">
              <div class="project-backdrop" aria-hidden="true">
                <img src={project.posterUrl} width="1280" height="720" alt="" loading="lazy" />
                <video muted playsinline loop preload="none" poster={project.posterUrl} tabindex="-1"></video>
              </div>
              <div class="project-scrim" aria-hidden="true"></div>
            </div>
            <div class="project-scan" aria-hidden="true"></div>
            <div class="project-glass" aria-hidden="true"></div>
            <button class="project-trigger" type="button" aria-controls={project.detailsId} aria-expanded="false" aria-label={`Show ${project.name} details`}></button>
            <div class="project-copy">
              <p class="project-kicker">{project.stack}</p>
              <h3 id={project.titleId}>{project.name}</h3>
              <div class="project-details" id={project.detailsId}>
                <p>{project.description}</p>
                {project.caseUrl
                  ? <a class="project-link" href={project.caseUrl}>Read case study <span aria-hidden="true">↗</span></a>
                  : <span class="project-placeholder">Case study in preparation</span>}
                <p class="project-media-note">{project.mediaNote}</p>
              </div>
            </div>
            <p class="project-status" role="status" aria-live="polite"></p>
            <div class="crt-shutter" aria-hidden="true"><span class="crt-shutter-line"></span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section container how" id="how-i-work" aria-labelledby="how-title">
      <p class="eyebrow how-index">03 / How I work</p>
      <div class="how-layout">
        <h2 id="how-title">Know the system.<br /><em>Then choose where to help.</em></h2>
        <div class="how-story">
          <p>Fadil and I both started by exploring the download side of monad-torrent. With time tight, he took the peer-download backend while I built the Brick interface. Understanding the backend first helped me shape the local torrent-file, download-path and keyboard flows around what the client actually needed. I kept a small set of actions direct rather than hiding them in a menu. The work made more sense to me this way: learn how the parts connect, then make the part I own fit the whole.</p>
          <a class="how-link" href="/work/monad-torrent/">Read the monad-torrent story <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="container approach-inner">
        <div class="approach-statement">
          <p class="eyebrow">04 / Approach</p>
          <h2 id="approach-title">Follow the problem<br /><em>across layers.</em></h2>
        </div>
        <div class="about-note" id="about">
          <p class="eyebrow">05 / About</p>
          <h3>What I'm working toward</h3>
          <p>I’m working toward DeFi engineering and building systems in the blockchain space. I’m drawn to work where engineering discipline has real consequences. Smart contracts make that clear: testing, understanding failure cases, and following proven practices matter before code goes live. Shipping fast is useful; shipping something that breaks can be far more costly.</p>
          <p>I enjoy the problems that should work but don’t. Finding the gap between what I expected and what the system actually does is challenging in the best way. It’s why I keep learning, testing my assumptions, and digging until I understand the cause.</p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <p class="eyebrow">06 / Contact</p>
        <h2 id="contact-title">Let's make the next<br /><em>system clearer.</em></h2>
        <address class="contact-links">
          <a href={`mailto:${contactEmail}`}>Email me <span aria-hidden="true">↗</span><span class="contact-email">{contactEmail}</span></a>
          <a href={linkedInUrl}>Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </address>
      </div>
      <section class="container tip-panel" aria-labelledby="tip-title" data-tip-panel>
        <div class="tip-heading">
          <p class="eyebrow">Optional / Leave a tip</p>
          <h3 id="tip-title">Support the work, if you like.</h3>
          <p>If this work helped, you can leave an optional ETH tip on Base. Connecting a wallet does not send funds.</p>
        </div>
        <dl class="tip-network"><div><dt>Network</dt><dd>Base Mainnet</dd></div><div><dt>Asset</dt><dd>ETH</dd></div></dl>
        <div class="tip-destination">
          <p class="tip-label">Full recipient address</p>
          <code data-tip-recipient>{TIP_RECIPIENT}</code>
          <button type="button" data-tip-copy hidden>Copy address</button>
          <p data-tip-copy-status role="status" aria-live="polite"></p>
        </div>
        <p class="tip-manual">No wallet? Copy the address and send ETH on Base from your own wallet. Check the network and full address first; other networks or assets may be lost.</p>
        <div class="tip-form" data-tip-form hidden>
          <fieldset class="tip-amounts">
            <legend>Choose an ETH amount</legend>
            <div class="tip-presets">
              <button type="button" data-tip-preset="0.001" aria-pressed="false">0.001 ETH</button>
              <button type="button" data-tip-preset="0.005" aria-pressed="false">0.005 ETH</button>
              <button type="button" data-tip-preset="0.01" aria-pressed="false">0.01 ETH</button>
            </div>
          </fieldset>
          <label class="tip-label" for="tip-custom">Or enter a custom amount in ETH</label>
          <input id="tip-custom" data-tip-custom type="text" inputmode="decimal" autocomplete="off" spellcheck="false" maxlength="24" aria-describedby="tip-amount-help tip-error" />
          <p id="tip-amount-help" class="tip-help">More than 0, at most 0.1 ETH, with up to 18 decimal places. No signs or exponent.</p>
          <p id="tip-error" class="tip-error" data-tip-error role="alert"></p>
          <p class="tip-selected">Selected: <output data-tip-amount>Choose an amount</output></p>
          <button class="tip-primary" type="button" data-tip-connect disabled>Connect wallet to review</button>
          <p class="tip-wallet-info" data-tip-wallet-info></p>
          <div class="tip-review" data-tip-review hidden role="group" aria-label="Review before wallet approval">
            <h4>Transfer review</h4>
            <dl>
              <div><dt>From wallet</dt><dd data-tip-account></dd></div>
              <div><dt>Network / asset</dt><dd>Base Mainnet (8453) / ETH</dd></div>
              <div><dt>Full destination</dt><dd><code>{TIP_RECIPIENT}</code></dd></div>
              <div><dt>Exact amount</dt><dd data-tip-review-amount></dd></div>
            </dl>
            <p>The wallet shows the final transfer and gas cost. Only approve if every detail matches; an approved transfer cannot be reversed.</p>
            <button class="tip-primary" type="button" data-tip-send disabled>Review transfer in wallet</button>
          </div>
          <p class="tip-status" data-tip-status role="status" aria-live="polite" tabindex="-1"></p>
          <p class="tip-hash" data-tip-hash hidden>Wallet-returned transaction hash: <code data-tip-hash-value></code></p>
          <a class="tip-receipt" data-tip-receipt href="#" target="_blank" rel="noopener noreferrer" hidden>View on BaseScan ↗</a>
        </div>
        <noscript><p class="tip-help">Wallet connection and the copy button need JavaScript. The full address above remains selectable for manual use.</p></noscript>
      </section>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-identity"> Davor Lucic / Portfolio</span>
      <div class="footer-socials">
        <span>Find me</span>
        <a href={`mailto:${contactEmail}`}>Email</a>
        <a href={linkedInUrl}>LinkedIn</a>
      </div>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>
  <div class="transmission-descent">
    <p class="terminal-line">End of transmission<span class="terminal-cursor" aria-hidden="true"></span></p>
  </div>
  <script>
    import { startSecondaryPowerOn } from '../scripts/crt-secondary-power';
    import { initBaseTip } from '../scripts/base-tip';

    const screen = document.querySelector<HTMLElement>('.crt-screen');
    const backdrop = screen?.querySelector<HTMLElement>('.crt-backdrop');
    const video = screen?.querySelector<HTMLVideoElement>('video');
    const status = screen?.querySelector<HTMLElement>('.crt-status');
    const shutter = screen?.querySelector<HTMLElement>('.crt-shutter');
    if (screen && backdrop && video && status && shutter) {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let inView = false;
      let failed = false;
      function release() {
        video!.pause();
        video!.removeAttribute('src');
        video!.load();
        backdrop!.classList.remove('has-frame');
      }
      async function sync() {
        if (reduced.matches) {
          document.documentElement.classList.remove('crt-turn-on');
          release();
          status!.textContent = 'Reduced motion: static poster only.';
          return;
        }
        if (failed) {
          status!.textContent = 'Video unavailable; poster remains visible.';
          return;
        }
        if (inView && !video!.getAttribute('src')) {
          video!.src = '/media/dunes-silent.mp4';
          video!.load();
        }
        if (inView && !document.hidden) {
          try { await video!.play(); }
          catch {
            if (inView && !document.hidden && !failed && !reduced.matches) {
              video!.pause();
              backdrop!.classList.remove('has-frame');
              status!.textContent = 'Video unavailable; poster remains visible.';
            }
          }
        } else video!.pause();
      }
      shutter.addEventListener('animationend', (event) => {
        if (event.animationName === 'crt-shutter-open') document.documentElement.classList.remove('crt-turn-on');
      });
      video.addEventListener('playing', () => {
        backdrop.classList.add('has-frame');
        status.textContent = '';
      });
      video.addEventListener('error', () => {
        failed = true;
        backdrop.classList.remove('has-frame');
        void sync();
      });
      reduced.addEventListener('change', () => { void sync(); });
      document.addEventListener('visibilitychange', () => { void sync(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; void sync(); }, { threshold: .05 }).observe(screen);
      } else { inView = true; void sync(); }
    }

    document.querySelectorAll<HTMLElement>('.project-screen').forEach(project => {
    const projectBackdrop = project.querySelector<HTMLElement>('.project-backdrop');
    const projectVideo = project.querySelector<HTMLVideoElement>('video');
    const projectStatus = project.querySelector<HTMLElement>('.project-status');
    const projectTrigger = project.querySelector<HTMLButtonElement>('.project-trigger');
    if (projectBackdrop && projectVideo && projectStatus && projectTrigger) {
      project.classList.add('is-interactive');
      project.addEventListener('pointerenter', () => project.classList.add('was-open'), { once: true });
      project.addEventListener('focusin', () => project.classList.add('was-open'), { once: true });
      const touchLayout = matchMedia('(max-width: 600px), (hover: none)');
      const setOpen = (open: boolean) => {
        project.classList.toggle('is-open', open);
        projectTrigger!.setAttribute('aria-expanded', String(open));
        projectTrigger!.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} ${project.dataset.projectName} details`);
      };
      const syncLayout = () => {
        if (touchLayout.matches) project.removeAttribute('tabindex');
        else { project.setAttribute('tabindex', '0'); setOpen(false); }
      };
      projectTrigger.addEventListener('click', () => setOpen(!project.classList.contains('is-open')));
      touchLayout.addEventListener('change', syncLayout);
      syncLayout();
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let visible = false;
      let failed = false;
      function releaseProject() {
        projectVideo!.pause();
        projectVideo!.removeAttribute('src');
        projectVideo!.load();
        projectBackdrop!.classList.remove('has-frame');
      }
      async function syncProject() {
        if (reduced.matches) {
          releaseProject();
          projectStatus!.textContent = ''; // The poster needs no extra resting text.
          return;
        }
        if (failed) {
          projectStatus!.textContent = 'Project video unavailable; still image shown.';
          return;
        }
        if (visible && !projectVideo!.getAttribute('src')) {
          projectVideo!.src = project.dataset.videoSrc!;
          projectVideo!.load();
        }
        if (visible && !document.hidden) {
          try { await projectVideo!.play(); }
          catch {
            if (visible && !document.hidden && !failed && !reduced.matches) {
              projectVideo!.pause();
              projectBackdrop!.classList.remove('has-frame');
              projectStatus!.textContent = 'Project video unavailable; still image shown.';
            }
          }
        } else projectVideo!.pause();
      }
      projectVideo.addEventListener('playing', () => {
        projectBackdrop.classList.add('has-frame');
        projectStatus.textContent = '';
      });
      projectVideo.addEventListener('error', () => {
        failed = true;
        projectBackdrop.classList.remove('has-frame');
        void syncProject();
      });
      reduced.addEventListener('change', () => { void syncProject(); });
      document.addEventListener('visibilitychange', () => { void syncProject(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; void syncProject(); }, { threshold: .05 }).observe(project);
      } else { visible = true; void syncProject(); }
    }
    });
    startSecondaryPowerOn(Array.from(document.querySelectorAll<HTMLElement>('.project-screen')));
    initBaseTip();
  </script>
</Layout>
