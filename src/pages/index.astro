---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'monad-torrent', titleId: 'project-title', detailsId: 'project-details',
    stack: 'Haskell / Brick', description: 'A simple torrent client written in Haskell using Brick.',
    url: 'https://github.com/davorluc/monad-torrent', linkLabel: 'View source on GitHub',
    mediaUrl: '/media/library-silent.mp4', posterUrl: '/media/library-poster.webp',
    mediaNote: 'Temporary library concept visual, not project imagery.',
    caseUrl: '/work/monad-torrent/',
  },
  {
    name: 'devchain', titleId: 'project-title-devchain', detailsId: 'project-details-devchain',
    stack: 'Rust / SHA-256', description: 'Early Rust blockchain study of proof-of-work blocks and transaction models.',
    url: 'https://github.com/davorluc/devchain', linkLabel: 'View source on GitHub',
    mediaUrl: '/media/settlement-silent.mp4', posterUrl: '/media/settlement-poster.webp',
    mediaNote: 'Temporary settlement concept visual, not blockchain or project footage.',
    caseUrl: null,
  },
  {
    name: 'Hydra', titleId: 'project-title-hydra', detailsId: 'project-details-hydra',
    stack: 'Aave / concept', description: 'A concept for an Aave liquidation bot with planned Rust monitoring and Solidity execution.',
    url: 'https://github.com/davorluc/hydra', linkLabel: 'View concept on GitHub',
    mediaUrl: '/media/hydra-storm-silent.mp4', posterUrl: '/media/hydra-storm-poster.webp',
    mediaNote: 'Temporary storm concept visual, not a built bot or project demo.',
    caseUrl: null,
  },
] as const;
---

<Layout
  title=" Davor Lucic — Data, web & infrastructure"
  description="Davor Lucic's portfolio: connecting data, web and infrastructure. Read the monad-torrent case study; more case studies and contact details are in preparation."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="crt-header crt-inner">
    <a class="wordmark" href="#top" aria-label=" Davor Lucic, back to top">Davor Lucic</a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#approach">Approach</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <section class="crt-screen" id="top" aria-labelledby="hero-title">
      <div class="crt-backdrop" aria-hidden="true">
        <img src="/media/dunes-poster.webp" width="1280" height="720" alt="" fetchpriority="high" />
        <video muted playsinline loop preload="none" poster="/media/dunes-poster.webp" tabindex="-1"></video>
      </div>
      <div class="crt-scrim" aria-hidden="true"></div>
      <div class="crt-scan" aria-hidden="true"></div>
      <div class="crt-glass" aria-hidden="true"></div>
      <div class="crt-edge" aria-hidden="true"></div>
      <div class="crt-hero crt-inner">
        <div class="crt-copy">
          <p class="crt-eyebrow crt-eyebrow-wide">Data engineering / Web development / DevOps</p>
          <p class="crt-eyebrow crt-eyebrow-short">Data / Web / DevOps</p>
          <h1 id="hero-title">I build across layers.</h1>
          <a class="crt-cta" href="#work">Explore portfolio <span aria-hidden="true">↓</span></a>
          <p class="crt-pending">More case studies and contact details are being prepared.</p>
        </div>
      </div>
      <p class="crt-status" role="status" aria-live="polite"></p>
    </section>

    <section class="section container work" id="work" aria-labelledby="work-title">
      <div class="work-intro">
        <div>
          <p class="eyebrow">02 / Selected work</p>
          <h2 id="work-title">Stories worth<br /><em>telling well.</em></h2>
        </div>
        <p>Real problems. Clear decisions. Outcomes that can be shared honestly.</p>
      </div>
      <div class="work-pending" role="note" aria-label="Case study publication status">
        <p class="eyebrow">Case studies / One available</p>
        <p>Read the monad-torrent case study. devchain and the Hydra concept are in preparation.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class:list={['project-screen', { 'has-case-study': Boolean(project.caseUrl) }]} data-project-name={project.name} data-video-src={project.mediaUrl} aria-labelledby={project.titleId} tabindex="0">
            <div class="project-media">
              <div class="project-backdrop" aria-hidden="true">
                <img src={project.posterUrl} width="1280" height="720" alt="" loading="lazy" />
                <video muted playsinline loop preload="none" poster={project.posterUrl} tabindex="-1"></video>
              </div>
              <div class="project-scrim" aria-hidden="true"></div>
            </div>
            <div class="project-scan" aria-hidden="true"></div>
            <div class="project-glass" aria-hidden="true"></div>
            <button class="project-toggle" type="button" aria-controls={project.detailsId} aria-expanded="false" aria-label={`Show ${project.name} details`}><span aria-hidden="true">+</span></button>
            <div class="project-copy">
              {project.caseUrl && <a class="project-case-link" href={project.caseUrl}><span>Read case study <span aria-hidden="true">↗</span></span></a>}
              <p class="project-kicker">{project.stack}</p>
              <h3 id={project.titleId}>{project.name}</h3>
              <div class="project-details" id={project.detailsId}>
                <p>{project.description}</p>
                <a class="project-link" href={project.url}>{project.linkLabel} <span aria-hidden="true">↗</span></a>
                <p class="project-media-note">{project.mediaNote}</p>
              </div>
            </div>
            <p class="project-status" role="status" aria-live="polite"></p>
          </article>
        ))}
      </div>
    </section>

    <section class="section container domains" id="domains" aria-labelledby="domains-title">
      <div class="domains-intro">
        <p class="eyebrow">03 / Across the system</p>
        <h2 id="domains-title">The layers connect.</h2>
      </div>
      <ol class="domain-list">
        <li><span class="domain-number">01 / Data</span><h3>Data <br /><em>engineering</em></h3><p>How information moves and becomes useful.</p></li>
        <li><span class="domain-number">02 / Web</span><h3>Web <br /><em>development</em></h3><p>How people meet a system through its interface.</p></li>
        <li><span class="domain-number">03 / Systems</span><h3>DevOps &amp; <br /><em>infrastructure</em></h3><p>How systems are delivered and kept running.</p></li>
      </ol>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="container approach-inner">
        <div class="approach-statement">
          <p class="eyebrow">04 / Approach</p>
          <h2 id="approach-title">Follow the problem<br /><em>across layers.</em></h2>
        </div>
        <div class="about-note" id="about">
          <p class="eyebrow">05 / About</p>
          <h3>About this portfolio</h3>
          <p>I studied computer science and have worked across data engineering, web development and DevOps. The interesting problems often sit between those layers.</p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <p class="eyebrow">06 / Contact</p>
        <h2 id="contact-title">Let's make the next<br /><em>system clearer.</em></h2>
        <p>Contact details are being confirmed before a direct link is published.</p>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-identity"> Davor Lucic / Portfolio</span>
      <div class="footer-socials">
        <span>Social profiles</span>
        <p>Links pending confirmation.</p>
      </div>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>
  <div class="transmission-descent">
    <p class="terminal-line">End of transmission<span class="terminal-cursor" aria-hidden="true"></span></p>
  </div>
  <script>
    const screen = document.querySelector<HTMLElement>('.crt-screen');
    const backdrop = screen?.querySelector<HTMLElement>('.crt-backdrop');
    const video = screen?.querySelector<HTMLVideoElement>('video');
    const status = screen?.querySelector<HTMLElement>('.crt-status');
    if (screen && backdrop && video && status) {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let inView = false;
      let failed = false;
      function release() {
        video!.pause();
        video!.removeAttribute('src');
        video!.load();
        backdrop!.classList.remove('has-frame');
      }
      async function sync() {
        if (reduced.matches) {
          release();
          status!.textContent = 'Reduced motion: static poster only.';
          return;
        }
        if (failed) {
          status!.textContent = 'Video unavailable; poster remains visible.';
          return;
        }
        if (inView && !video!.getAttribute('src')) {
          video!.src = '/media/dunes-silent.mp4';
          video!.load();
        }
        if (inView && !document.hidden) {
          try { await video!.play(); }
          catch {
            if (inView && !document.hidden && !failed && !reduced.matches) {
              video!.pause();
              backdrop!.classList.remove('has-frame');
              status!.textContent = 'Video unavailable; poster remains visible.';
            }
          }
        } else video!.pause();
      }
      video.addEventListener('playing', () => {
        backdrop.classList.add('has-frame');
        status.textContent = '';
      });
      video.addEventListener('error', () => {
        failed = true;
        backdrop.classList.remove('has-frame');
        void sync();
      });
      reduced.addEventListener('change', () => { void sync(); });
      document.addEventListener('visibilitychange', () => { void sync(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; void sync(); }, { threshold: .05 }).observe(screen);
      } else { inView = true; void sync(); }
    }

    document.querySelectorAll<HTMLElement>('.project-screen').forEach(project => {
    const projectBackdrop = project.querySelector<HTMLElement>('.project-backdrop');
    const projectVideo = project.querySelector<HTMLVideoElement>('video');
    const projectStatus = project.querySelector<HTMLElement>('.project-status');
    const projectToggle = project.querySelector<HTMLButtonElement>('.project-toggle');
    if (projectBackdrop && projectVideo && projectStatus && projectToggle) {
      const projectName = project.dataset.projectName ?? 'project';
      project.classList.add('is-interactive');
      project.addEventListener('pointerenter', () => project.classList.add('was-open'), { once: true });
      project.addEventListener('focusin', () => project.classList.add('was-open'), { once: true });
      projectToggle.addEventListener('click', () => {
        project.classList.add('was-open');
        const open = project.classList.toggle('is-open');
        projectToggle.setAttribute('aria-expanded', String(open));
        projectToggle.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} ${projectName} details`);
        projectToggle.querySelector('span')!.textContent = open ? '−' : '+';
      });
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let visible = false;
      let failed = false;
      function releaseProject() {
        projectVideo!.pause();
        projectVideo!.removeAttribute('src');
        projectVideo!.load();
        projectBackdrop!.classList.remove('has-frame');
      }
      async function syncProject() {
        if (reduced.matches) {
          releaseProject();
          projectStatus!.textContent = ''; // The poster needs no extra resting text.
          return;
        }
        if (failed) {
          projectStatus!.textContent = 'Project video unavailable; still image shown.';
          return;
        }
        if (visible && !projectVideo!.getAttribute('src')) {
          projectVideo!.src = project.dataset.videoSrc!;
          projectVideo!.load();
        }
        if (visible && !document.hidden) {
          try { await projectVideo!.play(); }
          catch {
            if (visible && !document.hidden && !failed && !reduced.matches) {
              projectVideo!.pause();
              projectBackdrop!.classList.remove('has-frame');
              projectStatus!.textContent = 'Project video unavailable; still image shown.';
            }
          }
        } else projectVideo!.pause();
      }
      projectVideo.addEventListener('playing', () => {
        projectBackdrop.classList.add('has-frame');
        projectStatus.textContent = '';
      });
      projectVideo.addEventListener('error', () => {
        failed = true;
        projectBackdrop.classList.remove('has-frame');
        void syncProject();
      });
      reduced.addEventListener('change', () => { void syncProject(); });
      document.addEventListener('visibilitychange', () => { void syncProject(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; void syncProject(); }, { threshold: .05 }).observe(project);
      } else { visible = true; void syncProject(); }
    }
    });
  </script>
</Layout>
