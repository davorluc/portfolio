---
const {
	eyebrow,
	title,
	summary,
	problem,
	meta = [],
	outcome,
	artifact,
	featured = false,
	href = '#contact',
	class: className = '',
} = Astro.props;
---

<article class:list={['panel project-card flex h-full flex-col', featured ? 'project-card--featured p-6 md:p-8' : 'project-card--support p-5 md:p-6', className]}>
	<div class="module-header">
		<p class="eyebrow">{eyebrow}</p>
		<span class="status-light">{featured ? 'primary module' : 'support module'}</span>
	</div>

	<div class="mt-4 flex items-start justify-between gap-4">
		<h3 class:list={['font-medium tracking-[-0.035em] text-[rgb(var(--text))]', featured ? 'text-2xl md:text-[1.65rem]' : 'text-xl']}>
			{title}
		</h3>
		{featured && <span class="artifact-chip">featured</span>}
	</div>

	<p class:list={['mt-3 text-[rgb(var(--muted))]', featured ? 'text-base leading-8' : 'text-sm leading-7']}>
		{summary}
	</p>

	<div class="mt-5 compartment p-4 md:p-5">
		<p class="readout">Problem</p>
		<p class:list={['mt-2 text-[rgb(var(--text))]', featured ? 'text-sm leading-7 md:text-base md:leading-8' : 'text-sm leading-6']}>
			{problem}
		</p>
	</div>

	<div class:list={['project-meta-grid mt-4', !featured && 'text-sm']}>
		{meta.map((item) => (
			<div class="project-meta">
				<p class="project-meta__label">{item.label}</p>
				<p class="project-meta__value">{item.value}</p>
			</div>
		))}
	</div>

	<div class="mt-4 flex items-center justify-between gap-3 border-t border-[rgb(var(--line) / 0.8)] pt-4">
		<div>
			<p class="readout">Outcome</p>
			<p class="mt-2 text-sm leading-6 text-[rgb(var(--text))]">{outcome}</p>
		</div>
		<div class="hidden shrink-0 md:block">
			<p class="project-artifact__label">Artifact</p>
			<p class="project-artifact__value">{artifact}</p>
		</div>
	</div>

	<div class="mt-5 flex items-center justify-between gap-3">
		<div class="project-artifact md:hidden">
			<p class="project-artifact__label">Artifact</p>
			<p class="project-artifact__value">{artifact}</p>
		</div>
		<a class="project-link ml-auto" href={href}>Ask for details</a>
	</div>
</article>
